{
  "log": {
    "level": "error",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "dns-direct",
        "type": "udp",
        "server": "223.5.5.5"
      },
      {
        "tag": "dns-proxy",
        "type": "https",
        "server": "8.8.8.8",
        "detour": "PROXY"
      },
      {
        "tag": "dns-fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15"
      }
    ],
    "rules": [
      {
        "query_type": "AAAA",
        "action": "predefined",
        "rcode": "NOERROR"
      },
      {
        "rule_set": "ads",
        "action": "predefined",
        "rcode": "NXDOMAIN"
      },
      {
        "rule_set": "geosite-cn",
        "server": "dns-direct"
      },
      {
        "query_type": "A",
        "server": "dns-fakeip"
      }
    ],
    "final": "dns-proxy",
    "strategy": "ipv4_only",
    "reverse_mapping": true
  },
  "http_clients": [
    {
      "tag": "client-proxy",
      "detour": "PROXY"
    }
  ],
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": "172.18.0.1/30",
      "auto_route": true,
      "strict_route": true,
      "stack": "system"
    }
  ],
  "outbounds": [
    {
      "tag": "DIRECT",
      "type": "direct"
    },
    {
      "tag": "PROXY",
      "type": "selector",
      "outbounds": [
        "DIRECT",
        "AUTO"
      ],
      "default": "AUTO"
    },
    {
      "tag": "AI",
      "type": "selector",
      "outbounds": [
        "DIRECT",
        "PROXY"
      ],
      "default": "PROXY"
    },
    {
      "tag": "Google",
      "type": "selector",
      "outbounds": [
        "DIRECT",
        "PROXY"
      ],
      "default": "PROXY"
    },
    {
      "tag": "Twitter",
      "type": "selector",
      "outbounds": [
        "DIRECT",
        "PROXY"
      ],
      "default": "PROXY"
    },
    {
      "tag": "AUTO",
      "type": "urltest",
      "outbounds": [],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "1m",
      "tolerance": 100,
      "interrupt_exist_connections": false
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "protocol": "quic",
        "action": "reject"
      },
      {
        "rule_set": "ads",
        "action": "reject"
      },
      {
        "ip_is_private": true,
        "outbound": "DIRECT"
      },
      {
        "rule_set": [
          "geosite-cn",
          "geoip-cn"
        ],
        "outbound": "DIRECT"
      },
      {
        "rule_set": "geosite-category-ai-!cn",
        "outbound": "AI"
      },
      {
        "rule_set": [
          "geosite-google",
          "geosite-googlefcm"
        ],
        "outbound": "Google"
      },
      {
        "rule_set": "geosite-twitter",
        "outbound": "Twitter"
      }
    ],
    "rule_set": [
      {
        "tag": "ads",
        "type": "remote",
        "format": "binary",
        "url": "https://fastly.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/category-ads-all.srs"
      },
      {
        "tag": "geosite-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://fastly.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/cn.srs"
      },
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://fastly.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/cn.srs"
      },
      {
        "tag": "geosite-google",
        "type": "remote",
        "format": "binary",
        "url": "https://fastly.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/google.srs"
      },
      {
        "tag": "geosite-googlefcm",
        "type": "remote",
        "format": "binary",
        "url": "https://fastly.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/googlefcm.srs"
      },
      {
        "tag": "geosite-category-ai-!cn",
        "type": "remote",
        "format": "binary",
        "url": "https://fastly.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/category-ai-!cn.srs"
      },
      {
        "tag": "geosite-twitter",
        "type": "remote",
        "format": "binary",
        "url": "https://fastly.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/twitter.srs"
      }
    ],
    "final": "PROXY",
    "auto_detect_interface": true,
    "default_domain_resolver": "dns-direct",
    "default_http_client": "client-proxy"
  }
}